---
/**
 * Breadcrumb.astro — Hierarchical breadcrumb for the Note Reader and Course pages.
 *
 * Renders one of two forms depending on whether `noteTitle` is provided:
 *   - Four items:  Home › Courses › [Course] › [Note]  (note reader pages)
 *   - Three items: Home › Courses › [Course]            (course detail pages)
 *
 * Requirements: 7.2, 15.1, 15.4
 *
 * - Uses <nav aria-label="breadcrumb"> for semantic landmark (Req 15.1, 15.4)
 * - Ordered list (<ol>) with <li> items per WCAG breadcrumb pattern
 * - Separator (›) is aria-hidden so screen readers skip it
 * - Final item (current page) carries aria-current="page" and has no link
 */

interface Props {
  /** Label for the Home link. Defaults to "Home" */
  homeLabel?: string;
  /** URL slug of the parent course (e.g. "claude-academy") */
  courseSlug: string;
  /** Display name of the parent course (e.g. "Claude Academy") */
  courseName: string;
  /**
   * Display title of the current note (e.g. "Anthropic Claude 101").
   * When omitted the breadcrumb renders three items and the course becomes
   * the current (active) item — used on course detail pages.
   */
  noteTitle?: string;
}

const { homeLabel = 'Home', courseSlug, courseName, noteTitle } = Astro.props;

// Strip trailing slash from base so links are always well-formed
const base = import.meta.env.BASE_URL.replace(/\/$/, '');

// Whether we are on a note reader page (four items) or course detail page (three items)
const isNotePage = noteTitle !== undefined && noteTitle !== null && noteTitle !== '';
---

<!--
  <nav> with aria-label="breadcrumb" is the recommended landmark for
  breadcrumb navigation (ARIA Authoring Practices Guide, breadcrumb pattern).
  Req 15.1: semantic <nav> element
  Req 15.4: aria-label on custom interactive component
-->
<nav aria-label="breadcrumb" class="breadcrumb">
  <!--
    <ol> conveys ordered sequence to assistive technologies.
    Each <li> is one level of the hierarchy.
  -->
  <ol class="breadcrumb-list" role="list">

    <!-- 1. Home -->
    <li class="breadcrumb-item">
      <a href={`${base}/`} class="breadcrumb-link">{homeLabel}</a>
    </li>

    <!-- Separator — aria-hidden so screen readers do not announce it -->
    <li class="breadcrumb-separator" aria-hidden="true">›</li>

    <!-- 2. Courses index -->
    <li class="breadcrumb-item">
      <a href={`${base}/courses`} class="breadcrumb-link">Courses</a>
    </li>

    <!-- Separator -->
    <li class="breadcrumb-separator" aria-hidden="true">›</li>

    {isNotePage ? (
      <>
        <!-- 3. Course detail page (link — not the current page) -->
        <li class="breadcrumb-item">
          <a href={`${base}/courses/${courseSlug}`} class="breadcrumb-link">
            {courseName}
          </a>
        </li>

        <!-- Separator -->
        <li class="breadcrumb-separator" aria-hidden="true">›</li>

        <!--
          4. Current note — no link; aria-current="page" signals the active page
          to assistive technologies (Req 7.2, 15.4).
        -->
        <li class="breadcrumb-item breadcrumb-item--current" aria-current="page">
          {noteTitle}
        </li>
      </>
    ) : (
      <!--
        3. Current course — no link; aria-current="page" signals the active page.
        Used on course detail pages where there is no note selected.
      -->
      <li class="breadcrumb-item breadcrumb-item--current" aria-current="page">
        {courseName}
      </li>
    )}

  </ol>
</nav>

<style>
  /* -------------------------------------------------------------------------
     Breadcrumb container
     ------------------------------------------------------------------------- */
  .breadcrumb {
    margin-bottom: 1.25rem;
  }

  /* -------------------------------------------------------------------------
     Ordered list — displayed horizontally with flex
     ------------------------------------------------------------------------- */
  .breadcrumb-list {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0 0.25rem;
    list-style: none;
    padding: 0;
    margin: 0;
    font-size: 0.8125rem;
    line-height: 1.5;
    color: var(--color-text-muted);
  }

  /* -------------------------------------------------------------------------
     Individual breadcrumb items
     ------------------------------------------------------------------------- */
  .breadcrumb-item {
    display: flex;
    align-items: center;
  }

  /* -------------------------------------------------------------------------
     Links
     Req 15.2: keyboard-focusable with visible focus indicator (Req 15.3)
     ------------------------------------------------------------------------- */
  .breadcrumb-link {
    color: var(--color-text-muted);
    text-decoration: none;
    border-radius: 3px;
    transition: color var(--transition-base);
    /* Slight padding to enlarge the focus hit area */
    padding: 0.1rem 0.2rem;
    margin: -0.1rem -0.2rem;
  }

  .breadcrumb-link:hover {
    color: var(--color-accent);
    text-decoration: underline;
  }

  /* Req 15.3: visible focus indicator meeting WCAG 2.1 AA non-text contrast */
  .breadcrumb-link:focus-visible {
    outline: 2px solid var(--color-accent);
    outline-offset: 2px;
    color: var(--color-accent);
  }

  /* -------------------------------------------------------------------------
     Separator character
     Decorative only — hidden from assistive technologies via aria-hidden
     ------------------------------------------------------------------------- */
  .breadcrumb-separator {
    /* Slightly smaller than body text to keep it unobtrusive */
    font-size: 0.75rem;
    color: var(--color-border);
    user-select: none;
    /* Extra horizontal space around the chevron */
    padding: 0 0.1rem;
  }

  /* -------------------------------------------------------------------------
     Current page item — plain text, no link, visually distinct
     aria-current="page" is set in the markup; CSS targets the class
     ------------------------------------------------------------------------- */
  .breadcrumb-item--current {
    color: var(--color-text);
    font-weight: 500;
    /* Truncate long note titles on very narrow viewports */
    max-width: 30ch;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }

  /* -------------------------------------------------------------------------
     Reduced motion — disable link color transition (Req 13.4)
     (global.css also blanket-removes transitions; this is a safety net)
     ------------------------------------------------------------------------- */
  @media (prefers-reduced-motion: reduce) {
    .breadcrumb-link {
      transition: none;
    }
  }
</style>
