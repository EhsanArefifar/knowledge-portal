---
/**
 * CopyButton.astro
 *
 * Client-side enhancement: injects a copy-to-clipboard button as a sibling
 * of every <pre> code block on the page via DOM post-processing at runtime.
 *
 * Strategy:
 *   1. Find all <pre> elements in the document.
 *   2. Wrap each one in a <div class="code-block-wrapper"> (position: relative)
 *      if not already wrapped (idempotent).
 *   3. Append a <button class="copy-btn"> inside the wrapper, absolutely
 *      positioned at the top-right corner of the code block.
 *   4. On click: use navigator.clipboard.writeText; on failure fall back to
 *      window.prompt with pre-selected text (Req 8.4 / design error-handling).
 *   5. After 2 s, reset the button label back to "Copy".
 *
 * No props — this component renders only a <script> and <style> tag.
 * Include it once in NoteLayout.astro (or any layout that renders notes).
 *
 * Requirements: 7.4, 8.4, 15.3, 15.4
 */
---

{/* No server-rendered markup — all DOM work happens at runtime */}

<style>
  /* -------------------------------------------------------------------------
     Wrapper — establishes the positioning context for the button
     ------------------------------------------------------------------------- */
  .code-block-wrapper {
    position: relative;
    /* Prevent the wrapper from collapsing around a scrollable <pre> */
    display: block;
  }

  /* -------------------------------------------------------------------------
     Copy button
     Base visual style matches the .btn class from global.css so the button
     is consistent with other interactive elements in the portal.
     Req 19.2 / 19.4: accent color, medium border-radius
     ------------------------------------------------------------------------- */
  .copy-btn {
    /* Positioning */
    position: absolute;
    top: 0.5rem;
    right: 0.5rem;
    z-index: 1;

    /* Layout */
    display: inline-flex;
    align-items: center;
    gap: 0.3rem;

    /* Typography */
    font-family: var(--font-ui);
    font-size: 0.75rem;
    font-weight: 500;
    line-height: 1.4;

    /* Appearance */
    color: var(--color-text-muted);
    background-color: var(--color-surface);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-btn);
    padding: 0.25rem 0.6rem;
    cursor: pointer;

    /* Transition — disabled under prefers-reduced-motion via global.css */
    transition:
      background-color var(--transition-base),
      border-color var(--transition-base),
      color var(--transition-base),
      opacity var(--transition-base);

    /* Start slightly transparent so it does not fight for attention */
    opacity: 0.7;
  }

  /* Raise opacity on hover so it is clearly interactive */
  .copy-btn:hover {
    opacity: 1;
    color: var(--color-text);
    background-color: var(--color-surface);
    border-color: var(--color-accent);
  }

  /* -------------------------------------------------------------------------
     Req 15.3: Visible focus indicator — meets WCAG 2.1 AA non-text contrast.
     global.css already defines :focus-visible for all elements, but we
     also set it explicitly here so the button's outline is always visible
     even if global styles are partially overridden by third-party CSS.
     ------------------------------------------------------------------------- */
  .copy-btn:focus-visible {
    outline: 2px solid var(--color-accent);
    outline-offset: 3px;
    border-radius: var(--radius-btn);
    opacity: 1;
  }

  /* Remove focus ring for pointer users (keep it for keyboard — Req 15.3) */
  .copy-btn:focus:not(:focus-visible) {
    outline: none;
  }

  /* -------------------------------------------------------------------------
     "Copied!" state
     ------------------------------------------------------------------------- */
  .copy-btn[data-copied="true"] {
    color: var(--color-accent);
    border-color: var(--color-accent);
    opacity: 1;
  }

  /* -------------------------------------------------------------------------
     Copy icon (clipboard SVG inline via CSS mask — no extra file dependency)
     The icon is injected by the script below; these rules size it correctly.
     ------------------------------------------------------------------------- */
  .copy-btn svg {
    flex-shrink: 0;
    pointer-events: none;
  }
</style>

<script>
  (function () {
    /**
     * Inject copy buttons into all <pre> elements found in the document.
     * Called on DOMContentLoaded (and safely re-callable for dynamic content).
     */
    function initCopyButtons(): void {
      const pres = document.querySelectorAll<HTMLPreElement>('pre');

      pres.forEach((pre) => {
        // Idempotency guard: skip if a button already exists in this <pre>'s parent
        if (pre.parentElement?.classList.contains('code-block-wrapper')) return;

        /* -----------------------------------------------------------------
           1. Wrap <pre> in a relative-positioned container
           ----------------------------------------------------------------- */
        const wrapper = document.createElement('div');
        wrapper.className = 'code-block-wrapper';
        pre.parentNode!.insertBefore(wrapper, pre);
        wrapper.appendChild(pre);

        /* -----------------------------------------------------------------
           2. Create the button
           Req 15.4: aria-label provides an accessible name for screen readers.
           ----------------------------------------------------------------- */
        const btn = document.createElement('button');
        btn.type = 'button';
        btn.className = 'copy-btn';
        btn.setAttribute('aria-label', 'Copy code');

        // Clipboard icon (inline SVG — no external asset dependency)
        btn.innerHTML = `
          <svg
            xmlns="http://www.w3.org/2000/svg"
            width="13"
            height="13"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="2"
            stroke-linecap="round"
            stroke-linejoin="round"
            aria-hidden="true"
            focusable="false"
          >
            <rect x="9" y="9" width="13" height="13" rx="2" ry="2"></rect>
            <path d="M5 15H4a2 2 0 0 1-2-2V4a2 2 0 0 1 2-2h9a2 2 0 0 1 2 2v1"></path>
          </svg>
          <span class="copy-btn__label">Copy</span>
        `;

        wrapper.appendChild(btn);

        /* -----------------------------------------------------------------
           3. Click handler
           ----------------------------------------------------------------- */
        let resetTimer: ReturnType<typeof setTimeout> | undefined;

        btn.addEventListener('click', () => {
          const labelEl = btn.querySelector<HTMLSpanElement>('.copy-btn__label');
          // Prefer innerText for visible text; fall back to textContent which
          // preserves whitespace better for code blocks
          const text = pre.innerText ?? pre.textContent ?? '';

          const showCopied = () => {
            btn.setAttribute('data-copied', 'true');
            btn.setAttribute('aria-label', 'Copied!');
            if (labelEl) labelEl.textContent = 'Copied!';

            clearTimeout(resetTimer);
            resetTimer = setTimeout(() => {
              btn.removeAttribute('data-copied');
              btn.setAttribute('aria-label', 'Copy code');
              if (labelEl) labelEl.textContent = 'Copy';
            }, 2000);
          };

          const showFallback = () => {
            // Req 8.4 / design: fall back to window.prompt when Clipboard API
            // is unavailable; the prompt pre-selects the text for easy Ctrl+C.
            window.prompt('Copy to clipboard: press Ctrl+C then Enter', text);
          };

          if (navigator.clipboard && navigator.clipboard.writeText) {
            navigator.clipboard.writeText(text).then(showCopied).catch(showFallback);
          } else {
            showFallback();
          }
        });
      });
    }

    // Run after the DOM is fully parsed
    if (document.readyState === 'loading') {
      document.addEventListener('DOMContentLoaded', initCopyButtons);
    } else {
      initCopyButtons();
    }
  })();
</script>
