---
/** Course summary card: provider logo, stats, reading progress and links. */
import Icon from './Icon.astro';
import ProviderLogo from './ProviderLogo.astro';
import { formatMinutes, type Course } from '../lib/content';

interface Props {
  course: Course;
}

const { course } = Astro.props;
const first = course.sections[0];
const ids = course.sections.map((s) => s.id).join('|');
---

<article class="course card" style={`--brand:${course.provider.color}`} data-progress={ids}>
  <div class="glow" aria-hidden="true"></div>
  <header class="top">
    <ProviderLogo provider={course.provider} size={44} />
    <div class="who">
      <span class="provider">{course.provider.name}</span>
      <h3 class="title"><a href={course.url}>{course.title}</a></h3>
    </div>
    <span class="badge badge-accent status">Current</span>
  </header>

  {course.description && <p class="desc">{course.description}</p>}

  <ul class="stats" aria-label="Course stats">
    <li><Icon name="layers" size={15} />{course.sections.length} chapters</li>
    <li><Icon name="clock" size={15} />{formatMinutes(course.totalMinutes)}</li>
    {course.assetCount > 0 && <li><Icon name="bot" size={15} />{course.assetCount} assets</li>}
  </ul>

  <div class="progress-row">
    <div class="progress"><span></span></div>
    <span class="progress-label" data-progress-label>Not started</span>
  </div>

  <footer class="links">
    {
      first && (
        <a class="btn btn-primary" href={first.url} data-continue={course.slug}>
          <span data-continue-label>Start reading</span>
          <Icon name="arrowRight" size={16} />
        </a>
      )
    }
    <a class="btn btn-ghost" href={course.url}>Overview</a>
    {
      course.sourceUrl && (
        <a class="btn btn-ghost ext" href={course.sourceUrl} target="_blank" rel="noopener noreferrer">
          Course site <Icon name="external" size={14} />
        </a>
      )
    }
  </footer>
</article>

<style>
  .course {
    position: relative;
    display: flex;
    flex-direction: column;
    gap: 1rem;
    padding: 1.4rem;
    overflow: hidden;
    transition: transform var(--t), box-shadow var(--t), border-color var(--t);
  }

  .course:hover {
    transform: translateY(-2px);
    box-shadow: var(--shadow);
    border-color: var(--border-strong);
  }

  .glow {
    position: absolute;
    inset: 0 0 auto;
    height: 120px;
    background: radial-gradient(120% 100% at 0% 0%, color-mix(in srgb, var(--brand) 16%, transparent), transparent 70%);
    pointer-events: none;
  }

  .top {
    position: relative;
    display: flex;
    align-items: center;
    gap: 0.85rem;
  }

  .who {
    min-width: 0;
  }

  .provider {
    font-size: 0.78rem;
    font-weight: 600;
    color: var(--text-muted);
  }

  .title {
    margin: 0.1rem 0 0;
    font-size: 1.15rem;
    font-weight: 700;
  }

  .title a {
    color: var(--text);
  }

  .title a::after {
    content: '';
    position: absolute;
    inset: 0;
    z-index: 0;
  }

  .status {
    margin-left: auto;
    align-self: flex-start;
  }

  .desc {
    position: relative;
    margin: 0;
    font-size: 0.9rem;
    line-height: 1.55;
    color: var(--text-muted);
  }

  .stats {
    display: flex;
    flex-wrap: wrap;
    gap: 0.4rem 1rem;
    margin: 0;
    padding: 0;
    list-style: none;
    font-size: 0.82rem;
    color: var(--text-muted);
  }

  .stats li {
    display: inline-flex;
    align-items: center;
    gap: 0.35rem;
  }

  .progress-row {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    margin-top: auto;
  }

  .progress-row .progress {
    flex: 1;
  }

  .progress-label {
    font-size: 0.78rem;
    color: var(--text-muted);
    white-space: nowrap;
  }

  .links {
    position: relative;
    z-index: 1;
    display: flex;
    flex-wrap: wrap;
    gap: 0.4rem;
  }

  .ext {
    margin-left: auto;
  }
</style>
