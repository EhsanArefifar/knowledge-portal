---
/**
 * DrawerNav.astro — Off-canvas drawer for mobile/tablet left sidebar navigation.
 *
 * Requirements: 14.3, 15.2, 15.3, 15.4
 *
 * - Toggle <button> outside the drawer with aria-label and aria-expanded
 * - Drawer panel is a <nav> element hidden off-screen via CSS transform
 * - Backdrop overlay closes drawer on click
 * - Escape key closes drawer
 * - Focus management: close button gets focus when opened; toggle button regains
 *   focus when closed
 * - Visible focus indicators on toggle button and all interior links
 */

interface Props {
  /** Accessible label for the <nav> element inside the drawer. Defaults to "Navigation" */
  label?: string;
}

const { label = 'Navigation' } = Astro.props;
---

<div class="drawer-nav-wrapper">
  <!--
    Toggle button — outside the drawer panel.
    Hidden on desktop (≥1024px) via CSS; shown on tablet and mobile.
    aria-expanded updated by JS when the drawer opens/closes.
  -->
  <button
    id="drawer-toggle"
    class="btn drawer-toggle"
    type="button"
    aria-label="Open navigation"
    aria-expanded="false"
    aria-controls="drawer-panel"
  >
    <!--
      Hamburger icon — three horizontal lines (visually represents a menu).
      aria-hidden so screen readers rely on aria-label above.
    -->
    <svg
      xmlns="http://www.w3.org/2000/svg"
      width="18"
      height="18"
      viewBox="0 0 24 24"
      fill="none"
      stroke="currentColor"
      stroke-width="2"
      stroke-linecap="round"
      stroke-linejoin="round"
      aria-hidden="true"
      focusable="false"
    >
      <line x1="3" y1="6"  x2="21" y2="6"  />
      <line x1="3" y1="12" x2="21" y2="12" />
      <line x1="3" y1="18" x2="21" y2="18" />
    </svg>
    <span class="sr-only">Open navigation</span>
  </button>

  <!--
    Backdrop overlay — covers the page when drawer is open.
    Clicking it closes the drawer.
    aria-hidden="true" because it has no semantic content.
  -->
  <div
    id="drawer-backdrop"
    class="drawer-backdrop"
    aria-hidden="true"
  ></div>

  <!--
    Drawer panel — a <nav> element positioned off-screen by default.
    Revealed via CSS class (no JS layout calculation needed).
    id="drawer-panel" matches aria-controls on the toggle button.
  -->
  <nav
    id="drawer-panel"
    class="drawer-panel"
    aria-label={label}
  >
    <!-- Drawer header with close button -->
    <div class="drawer-header">
      <span class="drawer-title">{label}</span>
      <button
        id="drawer-close"
        class="btn drawer-close-btn"
        type="button"
        aria-label="Close navigation"
      >
        <svg
          xmlns="http://www.w3.org/2000/svg"
          width="16"
          height="16"
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="2"
          stroke-linecap="round"
          stroke-linejoin="round"
          aria-hidden="true"
          focusable="false"
        >
          <line x1="18" y1="6"  x2="6"  y2="18" />
          <line x1="6"  y1="6"  x2="18" y2="18" />
        </svg>
      </button>
    </div>

    <!-- Navigation content passed via slot -->
    <div class="drawer-body">
      <slot />
    </div>
  </nav>
</div>

<script>
  (function () {
    const wrapper  = document.querySelector<HTMLElement>('.drawer-nav-wrapper');
    const toggle   = document.getElementById('drawer-toggle')  as HTMLButtonElement | null;
    const closeBtn = document.getElementById('drawer-close')   as HTMLButtonElement | null;
    const panel    = document.getElementById('drawer-panel')   as HTMLElement | null;
    const backdrop = document.getElementById('drawer-backdrop') as HTMLElement | null;

    if (!toggle || !panel || !backdrop) return;

    /** Open the drawer */
    function openDrawer(): void {
      panel!.classList.add('drawer-panel--open');
      backdrop!.classList.add('drawer-backdrop--visible');
      toggle!.setAttribute('aria-expanded', 'true');
      // Move keyboard focus to the close button for accessibility
      closeBtn?.focus();
    }

    /** Close the drawer */
    function closeDrawer(): void {
      panel!.classList.remove('drawer-panel--open');
      backdrop!.classList.remove('drawer-backdrop--visible');
      toggle!.setAttribute('aria-expanded', 'false');
      // Return focus to the toggle button
      toggle!.focus();
    }

    toggle.addEventListener('click', openDrawer);
    closeBtn?.addEventListener('click', closeDrawer);
    backdrop.addEventListener('click', closeDrawer);

    // Close on Escape key (Req 14.3)
    document.addEventListener('keydown', (e: KeyboardEvent) => {
      if (e.key === 'Escape' && panel!.classList.contains('drawer-panel--open')) {
        closeDrawer();
      }
    });
  })();
</script>

<style>
  /* -------------------------------------------------------------------------
     Toggle button
     Hidden on desktop (≥1024px); shown on tablet and mobile.
     Req 15.4: visible focus indicator
     ------------------------------------------------------------------------- */
  .drawer-toggle {
    display: flex;
    align-items: center;
    gap: 0.35rem;
    /* Override .btn padding for a square icon button */
    padding: 0.45rem 0.55rem;
  }

  @media (min-width: 1024px) {
    .drawer-toggle {
      display: none;
    }
  }

  /* -------------------------------------------------------------------------
     Backdrop overlay
     Covers the page when drawer is open; clicking closes the drawer.
     ------------------------------------------------------------------------- */
  .drawer-backdrop {
    /* Off by default: invisible and pointer-events disabled */
    position: fixed;
    inset: 0;
    background-color: rgba(0, 0, 0, 0.45);
    z-index: 199;
    opacity: 0;
    pointer-events: none;
    transition: opacity var(--transition-base);
  }

  .drawer-backdrop--visible {
    opacity: 1;
    pointer-events: auto;
  }

  /* -------------------------------------------------------------------------
     Drawer panel (<nav>)
     Off-screen by default via translateX(-100%); revealed by adding
     .drawer-panel--open which translates back to 0.
     Req 14.3: off-canvas panel
     Req 15.1: <nav> semantic element
     Req 15.4: focus indicators on all links inside (inherited from :focus-visible)
     ------------------------------------------------------------------------- */
  .drawer-panel {
    position: fixed;
    top: 0;
    left: 0;
    width: min(280px, 85vw);
    height: 100dvh;
    background-color: var(--color-surface);
    border-right: 1px solid var(--color-border);
    box-shadow: 2px 0 16px var(--color-shadow);
    z-index: 200;
    overflow-y: auto;
    display: flex;
    flex-direction: column;
    /* Hidden off-screen to the left */
    transform: translateX(-100%);
    transition: transform var(--transition-base);
  }

  .drawer-panel--open {
    transform: translateX(0);
  }

  /* -------------------------------------------------------------------------
     Drawer header
     ------------------------------------------------------------------------- */
  .drawer-header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 0.75rem 1rem;
    border-bottom: 1px solid var(--color-border);
    flex-shrink: 0;
  }

  .drawer-title {
    font-size: 0.875rem;
    font-weight: 600;
    color: var(--color-text-muted);
    text-transform: uppercase;
    letter-spacing: 0.06em;
  }

  .drawer-close-btn {
    padding: 0.35rem 0.45rem;
  }

  /* -------------------------------------------------------------------------
     Drawer body — slot content
     ------------------------------------------------------------------------- */
  .drawer-body {
    padding: 1rem;
    flex: 1;
    overflow-y: auto;
  }

  /* -------------------------------------------------------------------------
     Reduced motion — disable transform animation (Req 13.4)
     global.css already applies `transition: none` under prefers-reduced-motion,
     but this is a safety net for the panel's specific transform transition.
     ------------------------------------------------------------------------- */
  @media (prefers-reduced-motion: reduce) {
    .drawer-panel {
      transition: none;
    }

    .drawer-backdrop {
      transition: none;
    }
  }
</style>
