---
/**
 * External link row with provider logo — used for upcoming courses and resources.
 * The title link covers the whole card; `alsoOn` links sit above it as chips.
 */
import Icon from './Icon.astro';
import ProviderLogo from './ProviderLogo.astro';
import { getProvider } from '../data/providers';

interface Props {
  title: string;
  url: string;
  description?: string;
  provider?: string;
  index?: number;
  alsoOn?: { label: string; url: string }[];
}

const { title, url, description, provider, index, alsoOn = [] } = Astro.props;
const p = getProvider(provider ?? new URL(url).hostname);
---

<div class="link card">
  {index !== undefined && <span class="index">{String(index).padStart(2, '0')}</span>}
  <ProviderLogo provider={p} size={38} />
  <span class="text">
    <a class="title" href={url} target="_blank" rel="noopener noreferrer">{title}</a>
    {description && <span class="desc">{description}</span>}
    {
      (provider || alsoOn.length > 0) && (
        <span class="meta">
          {provider && <span class="provider">{p.name}</span>}
          {alsoOn.map((l) => (
            <a class="chip" href={l.url} target="_blank" rel="noopener noreferrer">
              Also on {l.label} <Icon name="external" size={11} />
            </a>
          ))}
        </span>
      )
    }
  </span>
  <Icon name="external" size={16} class="ext" />
</div>

<style>
  .link {
    position: relative;
    display: flex;
    align-items: center;
    gap: 0.9rem;
    padding: 0.9rem 1.1rem;
    border-radius: var(--radius);
    color: var(--text);
    transition: border-color var(--t-fast), transform var(--t-fast), box-shadow var(--t-fast);
  }

  .link:hover,
  .link:focus-within {
    color: var(--text);
    border-color: var(--border-strong);
    box-shadow: var(--shadow);
    transform: translateY(-1px);
  }

  .index {
    font-size: 0.78rem;
    font-weight: 700;
    color: var(--text-faint);
    font-variant-numeric: tabular-nums;
  }

  .text {
    display: flex;
    flex-direction: column;
    gap: 0.1rem;
    min-width: 0;
    flex: 1;
  }

  .title {
    font-weight: 600;
    line-height: 1.35;
    color: var(--text);
  }

  /* Stretch the title link over the card so the whole card is clickable. */
  .title::after {
    content: '';
    position: absolute;
    inset: 0;
    border-radius: inherit;
  }

  .title:focus-visible {
    outline: none;
  }

  .title:focus-visible::after {
    outline: 2px solid var(--accent);
    outline-offset: 2px;
  }

  .meta {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.35rem 0.6rem;
  }

  .chip {
    position: relative;
    z-index: 1;
    display: inline-flex;
    align-items: center;
    gap: 0.25rem;
    padding: 0.1rem 0.5rem;
    border-radius: var(--radius-pill);
    background: var(--surface-2);
    color: var(--text-muted);
    font-size: 0.72rem;
    font-weight: 600;
  }

  .chip:hover {
    background: var(--accent-soft);
    color: var(--accent);
  }

  .desc {
    font-size: 0.84rem;
    color: var(--text-muted);
    line-height: 1.45;
  }

  .provider {
    font-size: 0.72rem;
    font-weight: 600;
    color: var(--text-faint);
  }

  .link :global(.ext) {
    flex-shrink: 0;
    color: var(--text-faint);
  }

  .link:hover :global(.ext) {
    color: var(--accent);
  }
</style>
