---
/**
 * Command-palette style search built on Pagefind's JS API.
 *
 * Opens from any [data-search-open] button, Ctrl/⌘+K or "/". The index is
 * produced by `pagefind` after `astro build`, so search is unavailable in
 * `astro dev`. Only elements marked data-pagefind-body are indexed.
 */
import Icon from './Icon.astro';
---

<dialog id="search-dialog" class="search" aria-label="Search notes">
  <div class="search-panel">
    <div class="search-bar">
      <Icon name="search" size={18} class="search-icon" />
      <input
        id="search-input"
        type="search"
        placeholder="Search notes, chapters, assets…"
        autocomplete="off"
        spellcheck="false"
        aria-controls="search-results"
        aria-describedby="search-status"
      />
      <button type="button" class="btn btn-ghost btn-sm" data-search-close aria-label="Close search">
        <kbd>Esc</kbd>
      </button>
    </div>
    <div class="search-body">
      <p id="search-status" class="search-status" aria-live="polite">Type to search across every course.</p>
      <ul id="search-results" class="search-results" role="listbox" aria-label="Search results"></ul>
    </div>
    <div class="search-foot">
      <span><kbd>↑</kbd><kbd>↓</kbd> navigate</span>
      <span><kbd>↵</kbd> open</span>
      <span><kbd>Esc</kbd> close</span>
    </div>
  </div>
</dialog>

<style>
  .search {
    width: min(680px, calc(100vw - 1.5rem));
    max-height: min(640px, calc(100dvh - 4rem));
    margin: 8vh auto auto;
    padding: 0;
    border: 1px solid var(--border-strong);
    border-radius: var(--radius-lg);
    background: var(--bg-elevated);
    color: var(--text);
    box-shadow: var(--shadow-lg);
    overflow: hidden;
  }

  /* Only lay out when open — a closed <dialog> must stay display:none. */
  .search[open] {
    display: flex;
    animation: pop 160ms var(--ease);
  }

  .search::backdrop {
    background: var(--backdrop);
    backdrop-filter: blur(4px);
  }

  @keyframes pop {
    from {
      opacity: 0;
      transform: translateY(-6px) scale(0.985);
    }
  }

  .search-panel {
    display: flex;
    flex-direction: column;
    width: 100%;
    min-height: 0;
  }

  .search-bar {
    display: flex;
    align-items: center;
    gap: 0.6rem;
    padding: 0.4rem 0.6rem 0.4rem 1.1rem;
    border-bottom: 1px solid var(--border);
  }

  .search-bar :global(.search-icon) {
    color: var(--text-muted);
  }

  #search-input {
    flex: 1;
    min-width: 0;
    height: 3rem;
    border: none;
    outline: none;
    background: transparent;
    color: var(--text);
    font: inherit;
    font-size: 1.05rem;
  }

  #search-input::-webkit-search-cancel-button {
    display: none;
  }

  .search-body {
    flex: 1;
    min-height: 0;
    overflow-y: auto;
    padding: 0.5rem;
  }

  .search-status {
    margin: 0;
    padding: 1.5rem 1rem;
    text-align: center;
    color: var(--text-muted);
    font-size: 0.9rem;
  }

  .search-status:empty {
    display: none;
  }

  .search-results {
    list-style: none;
    margin: 0;
    padding: 0;
  }

  .search-results :global(a) {
    display: block;
    padding: 0.75rem 0.9rem;
    border-radius: var(--radius);
    color: var(--text);
  }

  .search-results :global(a[aria-selected='true']),
  .search-results :global(a:hover) {
    background: var(--accent-soft);
  }

  .search-results :global(.r-meta) {
    display: block;
    font-size: 0.72rem;
    font-weight: 600;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--text-muted);
  }

  .search-results :global(.r-title) {
    display: block;
    font-weight: 600;
    margin: 0.1rem 0 0.2rem;
  }

  .search-results :global(.r-excerpt) {
    display: block;
    font-size: 0.86rem;
    line-height: 1.5;
    color: var(--text-muted);
  }

  .search-results :global(mark) {
    background: transparent;
    color: var(--accent);
    font-weight: 600;
  }

  .search-results :global(.r-sub) {
    display: block;
    margin-top: 0.4rem;
    padding-left: 0.75rem;
    border-left: 2px solid var(--border);
    font-size: 0.82rem;
    color: var(--text-muted);
  }

  .search-results :global(.r-sub b) {
    color: var(--text);
    font-weight: 550;
  }

  .search-foot {
    display: flex;
    gap: 1.25rem;
    padding: 0.6rem 1.1rem;
    border-top: 1px solid var(--border);
    font-size: 0.75rem;
    color: var(--text-muted);
  }

  .search-foot kbd {
    margin-right: 0.2rem;
  }

  @media (max-width: 640px) {
    .search {
      margin-top: 0.75rem;
    }
    .search-foot {
      display: none;
    }
  }
</style>

<script>
  type PagefindSubResult = { title: string; url: string; excerpt: string };
  type PagefindData = {
    url: string;
    excerpt: string;
    meta: Record<string, string>;
    sub_results: PagefindSubResult[];
  };
  type Pagefind = {
    options: (o: Record<string, unknown>) => Promise<void>;
    init: () => Promise<void>;
    debouncedSearch: (
      q: string,
      o?: Record<string, unknown>,
      ms?: number,
    ) => Promise<{ results: { data: () => Promise<PagefindData> }[] } | null>;
  };

  const dialog = document.getElementById('search-dialog') as HTMLDialogElement;
  const input = document.getElementById('search-input') as HTMLInputElement;
  const list = document.getElementById('search-results') as HTMLUListElement;
  const status = document.getElementById('search-status') as HTMLElement;
  const base = import.meta.env.BASE_URL.replace(/\/$/, '');

  let pagefind: Pagefind | null = null;
  let loading: Promise<Pagefind | null> | null = null;
  let active = -1;

  function load(): Promise<Pagefind | null> {
    loading ??= (async () => {
      try {
        // Import at runtime, outside Vite: when Astro inlines this script a bundled
        // import() references an undefined __VITE_PRELOAD__ helper and throws.
        const runtimeImport = new Function('url', 'return import(url)') as (url: string) => Promise<Pagefind>;
        const pf = await runtimeImport(`${base}/_pagefind/pagefind.js`);
        await pf.options({ baseUrl: `${base}/` });
        await pf.init();
        pagefind = pf;
        return pf;
      } catch (err) {
        console.warn('[search] Pagefind index not available:', err);
        status.textContent = import.meta.env.DEV
          ? 'Search works on the built site — run `npm run build && npm run preview`.'
          : 'Search is unavailable right now. Try refreshing the page.';
        return null;
      }
    })();
    return loading;
  }

  function open(): void {
    if (dialog.open) return;
    dialog.showModal();
    input.select();
    void load();
  }

  function close(): void {
    if (dialog.open) dialog.close();
  }

  const escapeHtml = (s: string) =>
    s.replace(/[&<>"]/g, (c) => ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;' })[c]!);

  function render(results: PagefindData[], query: string): void {
    active = -1;
    list.innerHTML = '';
    if (!query) {
      status.textContent = 'Type to search across every course.';
      return;
    }
    if (results.length === 0) {
      status.textContent = `No results for “${query}”.`;
      return;
    }
    status.textContent = '';
    for (const r of results) {
      const subs = (r.sub_results ?? [])
        .filter((s) => s.url !== r.url && s.title !== r.meta.title)
        .slice(0, 2)
        .map((s) => `<span class="r-sub"><b>${escapeHtml(s.title)}</b> — ${s.excerpt}</span>`)
        .join('');
      const li = document.createElement('li');
      li.innerHTML =
        `<a href="${r.url}" role="option" aria-selected="false">` +
        `<span class="r-meta">${escapeHtml(r.meta.course ?? '')}</span>` +
        `<span class="r-title">${escapeHtml(r.meta.title ?? r.url)}</span>` +
        `<span class="r-excerpt">${r.excerpt}</span>${subs}</a>`;
      list.appendChild(li);
    }
  }

  async function search(query: string): Promise<void> {
    if (!pagefind) status.textContent = 'Loading search index…';
    const pf = pagefind ?? (await load());
    if (!pf) return;
    const q = query.trim();
    if (!q) return render([], '');
    const res = await pf.debouncedSearch(q, {}, 150);
    if (res === null) return; // superseded by a newer keystroke
    const data = await Promise.all(res.results.slice(0, 10).map((r) => r.data()));
    if (input.value.trim() === q) render(data, q);
  }

  function move(delta: number): void {
    const links = [...list.querySelectorAll<HTMLAnchorElement>('a')];
    if (!links.length) return;
    links[active]?.setAttribute('aria-selected', 'false');
    active = (active + delta + links.length) % links.length;
    links[active].setAttribute('aria-selected', 'true');
    links[active].scrollIntoView({ block: 'nearest' });
  }

  input.addEventListener('input', () => void search(input.value));
  input.addEventListener('keydown', (e) => {
    if (e.key === 'ArrowDown') {
      e.preventDefault();
      move(1);
    } else if (e.key === 'ArrowUp') {
      e.preventDefault();
      move(-1);
    } else if (e.key === 'Enter') {
      const target = list.querySelectorAll<HTMLAnchorElement>('a')[Math.max(active, 0)];
      if (target) {
        e.preventDefault();
        window.location.href = target.href;
      }
    }
  });

  list.addEventListener('click', (e) => {
    if ((e.target as Element).closest('a')) close();
  });
  dialog.addEventListener('click', (e) => {
    if (e.target === dialog) close();
  });
  document.querySelectorAll('[data-search-close]').forEach((b) => b.addEventListener('click', close));
  document.querySelectorAll('[data-search-open]').forEach((b) => b.addEventListener('click', open));

  document.addEventListener('keydown', (e) => {
    const typing = (e.target as HTMLElement).closest('input, textarea, [contenteditable]');
    if ((e.ctrlKey || e.metaKey) && e.key.toLowerCase() === 'k') {
      e.preventDefault();
      dialog.open ? close() : open();
    } else if (e.key === '/' && !typing && !dialog.open) {
      e.preventDefault();
      open();
    }
  });
</script>
