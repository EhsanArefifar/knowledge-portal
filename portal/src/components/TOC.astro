---
/**
 * TOC.astro — Table of Contents sidebar component.
 *
 * Requirements: 7.5, 7.6, 15.4
 *
 * - Accepts `headings` prop: array of { depth, slug, text } (Astro MarkdownHeading)
 * - Filters to H2 (depth 2) and H3 (depth 3) only
 * - If no H2/H3 headings are present, renders nothing (suppresses TOC — Req 7.6)
 * - Renders <nav aria-label="Table of contents"> with anchor links (Req 15.4)
 * - H3 items are visually indented relative to H2 items
 * - IntersectionObserver scroll-spy highlights the currently visible section (Req 7.5)
 */

export interface MarkdownHeading {
  depth: number;   // 1 = h1, 2 = h2, 3 = h3, etc.
  slug: string;    // auto-generated anchor id
  text: string;    // heading text content
}

interface Props {
  /** All headings extracted from the note (Astro renders these from the Markdown pipeline) */
  headings: MarkdownHeading[];
}

const { headings } = Astro.props;

// Filter to H2 and H3 only (Req 7.5, 7.6)
const tocHeadings = headings.filter((h) => h.depth === 2 || h.depth === 3);

// If no H2/H3 headings, render nothing — component outputs empty (Req 7.6)
---

{tocHeadings.length > 0 && (
  <nav aria-label="Table of contents" class="toc-nav">
    <p class="toc-title" aria-hidden="true">On this page</p>
    <ul class="toc-list" role="list">
      {tocHeadings.map((heading) => (
        <li
          class:list={[
            'toc-item',
            heading.depth === 3 ? 'toc-item--h3' : 'toc-item--h2',
          ]}
        >
          <a
            href={`#${heading.slug}`}
            class="toc-link"
            data-toc-target={heading.slug}
          >
            {heading.text}
          </a>
        </li>
      ))}
    </ul>
  </nav>
)}

<!--
  Scroll-spy script: uses IntersectionObserver to observe all H2/H3 elements
  inside the article. When a heading enters the viewport the corresponding TOC
  link receives the "toc-link--active" class (and aria-current="true").

  Req 7.5: highlights currently visible section
  Req 15.4: aria-current attribute on active link
-->
<script>
  (function () {
    /** All TOC anchor links rendered by this component */
    const tocLinks =
      document.querySelectorAll<HTMLAnchorElement>('a[data-toc-target]');

    if (!tocLinks.length) return;

    /** Map from heading id → TOC anchor element for fast lookup */
    const linkMap = new Map<string, HTMLAnchorElement>();
    tocLinks.forEach((a) => {
      const id = a.dataset.tocTarget;
      if (id) linkMap.set(id, a);
    });

    /** Collect the actual heading DOM elements in document order */
    const headingIds = Array.from(linkMap.keys());
    const headingEls: HTMLElement[] = headingIds
      .map((id) => document.getElementById(id))
      .filter((el): el is HTMLElement => el !== null);

    if (!headingEls.length) return;

    /** Set one link as active, removing active state from all others */
    function setActive(id: string): void {
      linkMap.forEach((anchor, anchorId) => {
        const isActive = anchorId === id;
        anchor.classList.toggle('toc-link--active', isActive);
        anchor.setAttribute('aria-current', isActive ? 'true' : 'false');
      });
    }

    /**
     * IntersectionObserver — triggers whenever a heading crosses the viewport.
     * rootMargin: negative bottom margin so the "active" heading is the one
     * currently near the top of the viewport rather than anywhere on screen.
     */
    const observer = new IntersectionObserver(
      (entries: IntersectionObserverEntry[]) => {
        // Among all entries currently intersecting, pick the one closest to
        // the top of the viewport (smallest positive boundingClientRect.top).
        const visible = entries
          .filter((e) => e.isIntersecting)
          .sort(
            (a, b) => a.boundingClientRect.top - b.boundingClientRect.top,
          );

        if (visible.length > 0) {
          setActive(visible[0].target.id);
        }
      },
      {
        // Keep upper 30 % of viewport as the "active zone"; anything below
        // 70 % from the top is not yet considered the active section.
        rootMargin: '0px 0px -70% 0px',
        threshold: 0,
      },
    );

    headingEls.forEach((el) => observer.observe(el));
  })();
</script>

<style>
  /* -------------------------------------------------------------------------
     TOC navigation container
     ------------------------------------------------------------------------- */
  .toc-nav {
    /* The component is placed inside an <aside>; no extra wrapper needed */
  }

  /* Small label above the list — decorative, hidden from screen readers */
  .toc-title {
    margin: 0 0 0.5rem;
    font-size: 0.75rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    color: var(--color-text-muted);
  }

  /* -------------------------------------------------------------------------
     TOC list
     ------------------------------------------------------------------------- */
  .toc-list {
    list-style: none;
    padding: 0;
    margin: 0;
    display: flex;
    flex-direction: column;
    gap: 0.125rem;
  }

  .toc-item {
    line-height: 1.4;
  }

  /* H3 entries indented relative to H2 */
  .toc-item--h3 {
    padding-left: 0.75rem;
  }

  /* -------------------------------------------------------------------------
     TOC anchor links
     Req 15.3: visible focus indicator
     Req 15.4: aria-current managed by JS
     ------------------------------------------------------------------------- */
  .toc-link {
    display: block;
    padding: 0.25rem 0.4rem;
    font-size: 0.8125rem;
    color: var(--color-text-muted);
    text-decoration: none;
    border-radius: 4px;
    transition: color var(--transition-base), background-color var(--transition-base);
  }

  .toc-link:hover,
  .toc-link:focus-visible {
    color: var(--color-text);
    background-color: var(--color-surface);
    outline: 2px solid var(--color-accent);
    outline-offset: 1px;
  }

  /* Active link — highlighted by IntersectionObserver scroll-spy */
  .toc-link--active {
    color: var(--color-accent);
    font-weight: 500;
  }

  /* -------------------------------------------------------------------------
     Reduced motion — disable link transitions (Req 13.4)
     ------------------------------------------------------------------------- */
  @media (prefers-reduced-motion: reduce) {
    .toc-link {
      transition: none;
    }
  }
</style>
