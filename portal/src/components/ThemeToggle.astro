---
/**
 * ThemeToggle.astro
 *
 * A button that toggles the `data-theme` attribute on <html> between
 * 'light' and 'dark', persisting the selection to localStorage.
 *
 * Requirements: 13.2, 13.3, 15.4
 */
---

<button
  id="theme-toggle"
  class="btn theme-toggle"
  aria-label="Toggle theme"
  type="button"
>
  {/* Sun icon — shown when dark theme is active (clicking switches to light) */}
  <svg
    class="icon icon-sun"
    xmlns="http://www.w3.org/2000/svg"
    width="16"
    height="16"
    viewBox="0 0 24 24"
    fill="none"
    stroke="currentColor"
    stroke-width="2"
    stroke-linecap="round"
    stroke-linejoin="round"
    aria-hidden="true"
    focusable="false"
  >
    <circle cx="12" cy="12" r="4" />
    <path d="M12 2v2M12 20v2M4.93 4.93l1.41 1.41M17.66 17.66l1.41 1.41M2 12h2M20 12h2M6.34 17.66l-1.41 1.41M19.07 4.93l-1.41 1.41" />
  </svg>

  {/* Moon icon — shown when light theme is active (clicking switches to dark) */}
  <svg
    class="icon icon-moon"
    xmlns="http://www.w3.org/2000/svg"
    width="16"
    height="16"
    viewBox="0 0 24 24"
    fill="none"
    stroke="currentColor"
    stroke-width="2"
    stroke-linecap="round"
    stroke-linejoin="round"
    aria-hidden="true"
    focusable="false"
  >
    <path d="M21 12.79A9 9 0 1 1 11.21 3a7 7 0 0 0 9.79 9.79z" />
  </svg>

  <span class="theme-label sr-only">Toggle theme</span>
</button>

<style>
  /*
   * The .btn base styles come from global.css.
   * These rules handle icon visibility based on the active theme.
   */
  .theme-toggle {
    /* Square icon button — slightly more compact than a text button */
    padding: 0.45rem 0.6rem;
  }

  /*
   * Icon display logic:
   *  - Dark theme active  → show sun (user can switch TO light)
   *  - Light theme active → show moon (user can switch TO dark)
   *
   * The selectors target :root / html via the data-theme attribute that the
   * theme initialization script in BaseLayout.astro sets before first paint.
   */

  /* Default (dark) — show sun, hide moon */
  .icon-moon { display: none; }
  .icon-sun  { display: inline-block; }

  /* Light theme — show moon, hide sun */
  :global([data-theme="light"]) .icon-sun  { display: none; }
  :global([data-theme="light"]) .icon-moon { display: inline-block; }

  /* Dark theme explicit — show sun, hide moon */
  :global([data-theme="dark"]) .icon-moon { display: none; }
  :global([data-theme="dark"]) .icon-sun  { display: inline-block; }
</style>

<script>
  (function () {
    const btn = document.getElementById('theme-toggle');
    if (!btn) return;

    btn.addEventListener('click', () => {
      const html = document.documentElement;
      const current = html.dataset.theme ?? 'dark';
      const next = current === 'dark' ? 'light' : 'dark';

      // Apply the new theme immediately
      html.dataset.theme = next;

      // Persist to localStorage; catch SecurityError in private-browsing mode
      try {
        localStorage.setItem('theme', next);
      } catch (_e) {
        // localStorage unavailable (e.g. private browsing) — silently ignore
      }
    });
  })();
</script>
