---
/**
 * BaseLayout — HTML shell for every page: theme bootstrapping, header with
 * navigation + search + theme toggle, footer, and shared client scripts.
 */
import '@fontsource-variable/inter';
import '@fontsource-variable/jetbrains-mono';
import '../styles/tokens.css';
import '../styles/global.css';
import Icon from '../components/Icon.astro';
import SearchDialog from '../components/SearchDialog.astro';
import { base, href } from '../lib/content';

interface Props {
  title: string;
  description?: string;
}

const { title, description = 'Personal AI learning portal — course notes, chapters and reusable Claude Code assets.' } =
  Astro.props;

const path = Astro.url.pathname.replace(base, '') || '/';
const nav = [
  { label: 'Courses', path: '/courses/' },
  { label: 'Up next', path: '/next-courses/' },
  { label: 'Resources', path: '/resources/' },
];
const isActive = (p: string) => path.startsWith(p);
const fullTitle = title === 'Home' ? 'Learning Portal' : `${title} · Learning Portal`;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="generator" content={Astro.generator} />
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    <link rel="icon" type="image/svg+xml" href={href('favicon.svg')} />
    <meta name="theme-color" content="#f7f6f3" media="(prefers-color-scheme: light)" />
    <meta name="theme-color" content="#0e1013" media="(prefers-color-scheme: dark)" />
    <script is:inline>
      (function () {
        var d = document.documentElement;
        function get(k) {
          try {
            return localStorage.getItem(k);
          } catch (e) {
            return null;
          }
        }
        var theme = get('theme');
        if (theme !== 'light' && theme !== 'dark') {
          theme = window.matchMedia('(prefers-color-scheme: dark)').matches ? 'dark' : 'light';
        }
        d.dataset.theme = theme;
        var size = get('kp:text-size');
        if (size === 's' || size === 'l') d.dataset.textSize = size;
        if (get('kp:focus') === '1') d.dataset.focus = '';
      })();
    </script>
    <slot name="head" />
  </head>

  <body>
    <a href="#main" class="skip-link">Skip to content</a>

    <header class="header">
      <div class="header-inner">
        <a href={href('/')} class="brand" aria-label="Learning Portal — home">
          <span class="brand-mark" aria-hidden="true">
            <svg viewBox="0 0 32 32" width="28" height="28">
              <defs>
                <linearGradient id="bm" x1="0" y1="0" x2="1" y2="1">
                  <stop offset="0" stop-color="#6d5efc" />
                  <stop offset="1" stop-color="#d97757" />
                </linearGradient>
              </defs>
              <rect width="32" height="32" rx="8" fill="url(#bm)" />
              <path d="M8 10.5c2.6-1.3 5.3-1.3 8 0v12c-2.7-1.3-5.4-1.3-8 0v-12Zm8 0c2.6-1.3 5.3-1.3 8 0v12c-2.7-1.3-5.4-1.3-8 0" fill="none" stroke="#fff" stroke-width="1.8" stroke-linejoin="round" />
            </svg>
          </span>
          <span class="brand-text">Learning Portal</span>
        </a>

        <nav class="nav" aria-label="Main">
          {
            nav.map((item) => (
              <a href={href(item.path)} class="nav-link" aria-current={isActive(item.path) ? 'page' : undefined}>
                {item.label}
              </a>
            ))
          }
        </nav>

        <div class="actions">
          <button type="button" class="search-btn" data-search-open aria-label="Search (Ctrl+K)" aria-keyshortcuts="Control+K Meta+K">
            <Icon name="search" size={16} />
            <span class="search-btn-label">Search</span>
            <kbd class="search-btn-kbd">Ctrl K</kbd>
          </button>
          <button type="button" class="btn btn-ghost btn-icon" id="theme-toggle" aria-label="Toggle dark mode">
            <Icon name="sun" class="i-sun" />
            <Icon name="moon" class="i-moon" />
          </button>
          <details class="mobile-menu">
            <summary class="btn btn-ghost btn-icon" aria-label="Open menu">
              <Icon name="menu" />
            </summary>
            <nav class="mobile-nav card" aria-label="Main (mobile)">
              <a href={href('/')}>Home</a>
              {nav.map((item) => <a href={href(item.path)} aria-current={isActive(item.path) ? 'page' : undefined}>{item.label}</a>)}
            </nav>
          </details>
        </div>
      </div>
    </header>

    <SearchDialog />

    <main id="main">
      <slot />
    </main>

    <footer class="footer">
      <div class="container footer-inner">
        <span>Learning Portal · notes rendered from Markdown</span>
        <span class="footer-keys"><kbd>/</kbd> search · <kbd>←</kbd><kbd>→</kbd> previous / next chapter</span>
      </div>
    </footer>

    <script>
      import { addCopyButtons, enhanceDiagrams } from '../scripts/enhance';

      addCopyButtons();
      enhanceDiagrams();

      const root = document.documentElement;
      document.getElementById('theme-toggle')?.addEventListener('click', () => {
        const next = root.dataset.theme === 'dark' ? 'light' : 'dark';
        root.dataset.theme = next;
        try {
          localStorage.setItem('theme', next);
        } catch {
          /* ignore */
        }
      });

      // Close the mobile menu after navigating or clicking outside.
      const menu = document.querySelector<HTMLDetailsElement>('.mobile-menu');
      document.addEventListener('click', (e) => {
        if (menu?.open && !menu.contains(e.target as Node)) menu.open = false;
      });
    </script>
  </body>
</html>

<style>
  .header {
    position: sticky;
    top: 0;
    z-index: 50;
    height: var(--header-h);
    background: color-mix(in srgb, var(--bg) 82%, transparent);
    backdrop-filter: saturate(1.6) blur(14px);
    -webkit-backdrop-filter: saturate(1.6) blur(14px);
    border-bottom: 1px solid var(--border);
  }

  .header-inner {
    display: flex;
    align-items: center;
    gap: 1.5rem;
    height: 100%;
    max-width: 1440px;
    margin-inline: auto;
    padding-inline: clamp(1rem, 3vw, 1.75rem);
  }

  .brand {
    display: inline-flex;
    align-items: center;
    gap: 0.6rem;
    color: var(--text);
    font-weight: 700;
    letter-spacing: -0.02em;
    flex-shrink: 0;
  }

  .brand:hover {
    color: var(--text);
  }

  .brand-mark {
    display: inline-flex;
    filter: drop-shadow(0 2px 6px rgba(109, 94, 252, 0.35));
  }

  .nav {
    display: flex;
    gap: 0.25rem;
  }

  .nav-link {
    padding: 0.45rem 0.75rem;
    border-radius: var(--radius-sm);
    color: var(--text-muted);
    font-size: 0.9rem;
    font-weight: 550;
    transition: color var(--t-fast), background-color var(--t-fast);
  }

  .nav-link:hover {
    color: var(--text);
    background: var(--surface-hover);
  }

  .nav-link[aria-current='page'] {
    color: var(--text);
    background: var(--surface-2);
  }

  .actions {
    display: flex;
    align-items: center;
    gap: 0.35rem;
    margin-left: auto;
  }

  .search-btn {
    display: inline-flex;
    align-items: center;
    gap: 0.55rem;
    height: 2.25rem;
    width: 15rem;
    padding: 0 0.5rem 0 0.8rem;
    border: 1px solid var(--border);
    border-radius: var(--radius-pill);
    background: var(--surface);
    color: var(--text-muted);
    font-size: 0.875rem;
    cursor: pointer;
    transition: border-color var(--t-fast), box-shadow var(--t-fast);
  }

  .search-btn:hover {
    border-color: var(--border-strong);
    box-shadow: var(--shadow-sm);
  }

  .search-btn-kbd {
    margin-left: auto;
  }

  #theme-toggle :global(.i-moon) {
    display: none;
  }

  :global(:root[data-theme='dark']) #theme-toggle :global(.i-moon) {
    display: block;
  }

  :global(:root[data-theme='dark']) #theme-toggle :global(.i-sun) {
    display: none;
  }

  .mobile-menu {
    display: none;
    position: relative;
  }

  .mobile-menu summary {
    list-style: none;
  }

  .mobile-menu summary::-webkit-details-marker {
    display: none;
  }

  .mobile-nav {
    position: absolute;
    right: 0;
    top: calc(100% + 0.5rem);
    display: flex;
    flex-direction: column;
    min-width: 12rem;
    padding: 0.4rem;
    box-shadow: var(--shadow-lg);
  }

  .mobile-nav a {
    padding: 0.65rem 0.8rem;
    border-radius: var(--radius-sm);
    color: var(--text);
    font-weight: 550;
  }

  .mobile-nav a:hover,
  .mobile-nav a[aria-current='page'] {
    background: var(--surface-2);
  }

  .footer {
    margin-top: 4rem;
    border-top: 1px solid var(--border);
    font-size: 0.8125rem;
    color: var(--text-muted);
  }

  .footer-inner {
    display: flex;
    justify-content: space-between;
    flex-wrap: wrap;
    gap: 0.5rem 1.5rem;
    padding-block: 1.5rem;
  }

  :global(:root[data-focus]) .footer {
    display: none;
  }

  @media (max-width: 900px) {
    .search-btn {
      width: auto;
    }
    .search-btn-kbd {
      display: none;
    }
  }

  @media (max-width: 720px) {
    .nav {
      display: none;
    }
    .mobile-menu {
      display: block;
    }
    .search-btn {
      width: 2.25rem;
      padding: 0;
      justify-content: center;
    }
    .search-btn-label {
      display: none;
    }
    .footer-keys {
      display: none;
    }
  }
</style>
