---
/**
 * NoteLayout.astro — Three-column layout for the Note Reader
 *
 * Requirements: 7.1, 14.1, 14.2, 14.3, 15.1
 *
 * - Three-column CSS Grid: left sidebar (note list) | article (content) | right aside (TOC)
 * - ≥1024px: three columns (240px 1fr 220px)
 * - 640–1023px: two columns (content + TOC); left sidebar hidden, accessible via DrawerNav
 * - <640px: single column; left sidebar in DrawerNav component
 * - Accepts headings prop for inline TOC rendering
 * - Uses BaseLayout as outer shell
 */

import BaseLayout from './BaseLayout.astro';
import DrawerNav from '../components/DrawerNav.astro';
import TOC from '../components/TOC.astro';

export interface Heading {
  depth: number;   // 1 = h1, 2 = h2, 3 = h3, etc.
  text: string;
  slug: string;
}

interface Props {
  /** Page / note title — passed to BaseLayout <title> */
  title: string;
  /** Optional page meta description */
  description?: string;
  /** Slug of the parent course (e.g. "claude-academy") */
  courseSlug: string;
  /** Display name of the parent course (e.g. "Claude Academy") */
  courseName: string;
  /** All notes in this course for the left sidebar list */
  notes: Array<{ slug: string; title: string }>;
  /** Slug of the note currently being viewed */
  currentNoteSlug: string;
  /** H2/H3 headings extracted from the note — used to render the inline TOC */
  headings?: Heading[];
}

const {
  title,
  description,
  courseSlug,
  courseName,
  notes,
  currentNoteSlug,
  headings = [],
} = Astro.props;

// Base URL (e.g. "/knowledge-portal")
const base = import.meta.env.BASE_URL.replace(/\/$/, '');

// Only show TOC when there are H2 or H3 headings
const tocHeadings = headings.filter((h) => h.depth === 2 || h.depth === 3);
const hasToc = tocHeadings.length > 0;
---

<BaseLayout title={title} description={description}>
  <!--
    DrawerNav wraps the note list for mobile/tablet off-canvas access.
    On desktop (≥1024px) the toggle button is hidden; the sidebar is
    shown directly in the grid.
  -->
  <DrawerNav label="Open course navigation">
    <!-- Slot content: note list for the drawer -->
    <nav aria-label={`Notes in ${courseName}`} class="drawer-note-list">
      <p class="sidebar-course-label">
        <a href={`${base}/courses/${courseSlug}`} class="course-back-link">
          ← {courseName}
        </a>
      </p>
      <ul class="note-list" role="list">
        {notes.map((note) => (
          <li>
            <a
              href={`${base}/courses/${courseSlug}/${note.slug}`}
              class:list={[
                'note-list-link',
                { 'note-list-link--active': note.slug === currentNoteSlug },
              ]}
              aria-current={note.slug === currentNoteSlug ? 'page' : undefined}
            >
              {note.title}
            </a>
          </li>
        ))}
      </ul>
    </nav>
  </DrawerNav>

  <!--
    Responsive layout container.
    CSS classes (defined below + in global.css) switch the grid at breakpoints.
  -->
  <div class="layout-reader">

    <!--
      Left aside — note list sidebar.
      Visible on desktop (≥1024px); hidden on tablet/mobile (handled by DrawerNav).
    -->
    <aside class="sidebar-left" aria-label={`Notes in ${courseName}`}>
      <p class="sidebar-course-label">
        <a href={`${base}/courses/${courseSlug}`} class="course-back-link">
          ← {courseName}
        </a>
      </p>
      <nav aria-label="Course notes">
        <ul class="note-list" role="list">
          {notes.map((note) => (
            <li>
              <a
                href={`${base}/courses/${courseSlug}/${note.slug}`}
                class:list={[
                  'note-list-link',
                  { 'note-list-link--active': note.slug === currentNoteSlug },
                ]}
                aria-current={note.slug === currentNoteSlug ? 'page' : undefined}
              >
                {note.title}
              </a>
            </li>
          ))}
        </ul>
      </nav>
    </aside>

    <!--
      Center column — note content.
      The <article> element provides a semantic document landmark (Req 15.1).
    -->
    <article class="layout-content note-content">
      <slot />
    </article>

    <!--
      Right aside — Table of Contents (TOC).
      TOC.astro renders nothing when no H2/H3 headings exist (Req 7.6).
      The sidebar-right wrapper is only shown when there is content to display.
    -->
    {hasToc && (
      <aside class="sidebar-right" aria-label="Table of contents">
        <TOC headings={headings} />
      </aside>
    )}
  </div>
</BaseLayout>

<!-- TOC scroll-spy script — highlights the active heading as user scrolls -->
<script>
  (function () {
    const tocLinks = document.querySelectorAll<HTMLAnchorElement>('.toc-link');
    if (!tocLinks.length) return;

    const headingIds = Array.from(tocLinks).map((a) => {
      const href = a.getAttribute('href') ?? '';
      return href.startsWith('#') ? href.slice(1) : '';
    }).filter(Boolean);

    const headingEls = headingIds
      .map((id) => document.getElementById(id))
      .filter((el): el is HTMLElement => el !== null);

    function setActive(id: string) {
      tocLinks.forEach((a) => {
        const isActive = a.getAttribute('href') === `#${id}`;
        a.classList.toggle('toc-link--active', isActive);
        a.setAttribute('aria-current', isActive ? 'true' : 'false');
      });
    }

    const observer = new IntersectionObserver(
      (entries) => {
        // Find the topmost entry currently intersecting
        const visible = entries
          .filter((e) => e.isIntersecting)
          .sort((a, b) => a.boundingClientRect.top - b.boundingClientRect.top);

        if (visible.length > 0) {
          setActive(visible[0].target.id);
        }
      },
      { rootMargin: '0px 0px -70% 0px', threshold: 0 }
    );

    headingEls.forEach((el) => observer.observe(el));
  })();
</script>

<style>
  /* -------------------------------------------------------------------------
     Sidebar: note list
     ------------------------------------------------------------------------- */
  .sidebar-course-label {
    margin-bottom: 0.75rem;
    font-size: 0.8rem;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.06em;
    color: var(--color-text-muted);
  }

  .course-back-link {
    color: var(--color-text-muted);
    text-decoration: none;
    transition: color var(--transition-base);
  }

  .course-back-link:hover,
  .course-back-link:focus-visible {
    color: var(--color-accent);
  }

  .note-list {
    list-style: none;
    padding: 0;
    margin: 0;
    display: flex;
    flex-direction: column;
    gap: 0.125rem;
  }

  .note-list-link {
    display: block;
    padding: 0.4rem 0.6rem;
    font-size: 0.875rem;
    color: var(--color-text-muted);
    text-decoration: none;
    border-radius: var(--radius-btn);
    transition: color var(--transition-base), background-color var(--transition-base);
    line-height: 1.4;
  }

  .note-list-link:hover,
  .note-list-link:focus-visible {
    color: var(--color-text);
    background-color: var(--color-surface);
  }

  .note-list-link--active {
    color: var(--color-accent);
    background-color: var(--color-surface);
    font-weight: 500;
  }

  /* -------------------------------------------------------------------------
     Right sidebar: Table of Contents
     ------------------------------------------------------------------------- */
  .toc-heading {
    margin-bottom: 0.5rem;
    font-size: 0.75rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    color: var(--color-text-muted);
  }

  .toc-list {
    list-style: none;
    padding: 0;
    margin: 0;
    display: flex;
    flex-direction: column;
    gap: 0.125rem;
  }

  .toc-item {
    line-height: 1.4;
  }

  /* Indent H3 entries */
  .toc-item--h3 {
    padding-left: 0.75rem;
  }

  .toc-link {
    display: block;
    padding: 0.25rem 0.4rem;
    font-size: 0.8125rem;
    color: var(--color-text-muted);
    text-decoration: none;
    border-radius: 4px;
    transition: color var(--transition-base), background-color var(--transition-base);
  }

  .toc-link:hover,
  .toc-link:focus-visible {
    color: var(--color-text);
    background-color: var(--color-surface);
  }

  .toc-link--active {
    color: var(--color-accent);
    font-weight: 500;
  }

  /* -------------------------------------------------------------------------
     DrawerNav note list (inside the drawer on mobile/tablet)
     ------------------------------------------------------------------------- */
  .drawer-note-list {
    /* inherits sidebar styles from .note-list etc. above */
  }

  /* -------------------------------------------------------------------------
     Responsive: override layout-reader for this layout
     (global.css provides the base .layout-reader rules;
      these overrides sit in component scope)
     ------------------------------------------------------------------------- */

  /* Desktop (≥1024px): three columns */
  @media (min-width: 1024px) {
    /* .layout-reader grid is already defined in global.css */
    /* Ensure the DrawerNav toggle is hidden on desktop */
    :global(.drawer-toggle) {
      display: none !important;
    }
  }

  /* Tablet (640px–1023px): two columns, left sidebar hidden in drawer */
  @media (min-width: 640px) and (max-width: 1023px) {
    :global(.drawer-toggle) {
      display: flex;
    }
  }

  /* Mobile (<640px): single column, all sidebars in drawer */
  @media (max-width: 639px) {
    :global(.drawer-toggle) {
      display: flex;
    }

    /* Hide static right sidebar (TOC) on mobile */
    .sidebar-right {
      display: none;
    }
  }
</style>
