---
/** Note overview — the note's intro and its chapters. */
import type { GetStaticPaths } from 'astro';
import BaseLayout from '../../../../layouts/BaseLayout.astro';
import ChapterList from '../../../../components/ChapterList.astro';
import Icon from '../../../../components/Icon.astro';
import { getCourses, type Course, type Note } from '../../../../lib/content';

export const getStaticPaths: GetStaticPaths = async () => {
  const courses = await getCourses();
  return courses.flatMap((course) =>
    course.notes.map((note) => ({ params: { course: course.slug, note: note.slug }, props: { course, note } })),
  );
};

const { course, note } = Astro.props as { course: Course; note: Note };
---

<BaseLayout title={`${note.title} — ${course.title}`}>
  <div class="container page">
    <nav class="crumbs" aria-label="Breadcrumb">
      <a href={course.url}>{course.title}</a>
      <Icon name="chevronRight" size={14} />
      <span>{note.title}</span>
    </nav>

    <header class="head">
      <h1>{note.title}</h1>
      <p class="muted">{note.sections.length} chapters</p>
    </header>

    {note.introHtml && <div class="prose intro" set:html={note.introHtml} />}

    <ChapterList sections={note.sections} />
  </div>
</BaseLayout>

<style>
  .page {
    max-width: 860px;
    padding-top: 2rem;
  }

  .crumbs {
    display: flex;
    align-items: center;
    gap: 0.35rem;
    font-size: 0.84rem;
    color: var(--text-muted);
  }

  .crumbs a {
    color: var(--text-muted);
  }

  .head {
    margin: 1.5rem 0 2rem;
  }

  h1 {
    margin: 0 0 0.4rem;
    font-size: clamp(1.8rem, 1.3rem + 1.8vw, 2.4rem);
    font-weight: 750;
    letter-spacing: -0.025em;
  }

  .head p {
    margin: 0;
  }

  .intro {
    margin-bottom: 2rem;
    padding: 1.1rem 1.3rem;
    border-radius: var(--radius);
    background: var(--surface-2);
    font-size: 0.95rem;
  }

  .intro :global(> :last-child) {
    margin-bottom: 0;
  }
</style>
