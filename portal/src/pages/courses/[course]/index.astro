---
/** Course hub — header, progress, chapters per note and reusable assets. */
import type { GetStaticPaths } from 'astro';
import BaseLayout from '../../../layouts/BaseLayout.astro';
import AssetList from '../../../components/AssetList.astro';
import ChapterList from '../../../components/ChapterList.astro';
import Icon from '../../../components/Icon.astro';
import ProviderLogo from '../../../components/ProviderLogo.astro';
import { formatMinutes, getCourses, href, type Course } from '../../../lib/content';

export const getStaticPaths: GetStaticPaths = async () => {
  const courses = await getCourses();
  return courses.map((course) => ({ params: { course: course.slug }, props: { course } }));
};

const { course } = Astro.props as { course: Course };
const first = course.sections[0];
---

<BaseLayout title={course.title} description={course.description}>
  <section class="hero" style={`--brand:${course.provider.color}`} data-progress={course.sections.map((s) => s.id).join('|')}>
    <div class="container hero-inner">
      <a href={href('courses/')} class="back"><Icon name="arrowLeft" size={14} /> All courses</a>
      <div class="hero-main">
        <ProviderLogo provider={course.provider} size={64} />
        <div>
          <p class="eyebrow">{course.provider.name} · Current course</p>
          <h1>{course.title}</h1>
        </div>
      </div>
      {course.description && <p class="desc">{course.description}</p>}

      <ul class="stats">
        <li><strong>{course.notes.length}</strong> {course.notes.length === 1 ? 'note' : 'notes'}</li>
        <li><strong>{course.sections.length}</strong> chapters</li>
        <li><strong>{formatMinutes(course.totalMinutes)}</strong> reading</li>
        {course.assetCount > 0 && <li><strong>{course.assetCount}</strong> assets</li>}
      </ul>

      <div class="progress-row">
        <div class="progress"><span></span></div>
        <span data-progress-label>Not started</span>
      </div>

      <div class="cta">
        {
          first && (
            <a class="btn btn-primary" href={first.url} data-continue={course.slug}>
              <span data-continue-label>Start reading</span> <Icon name="arrowRight" size={16} />
            </a>
          )
        }
        {
          course.sourceUrl && (
            <a class="btn" href={course.sourceUrl} target="_blank" rel="noopener noreferrer">
              Open course on {course.provider.name} <Icon name="external" size={14} />
            </a>
          )
        }
        {
          course.assetCount > 0 && (
            <a class="btn btn-ghost" href="#assets">
              <Icon name="bot" size={16} /> Assets
            </a>
          )
        }
      </div>
    </div>
  </section>

  <div class="container body">
    {
      course.notes.map((note) => (
        <section class="note">
          <div class="section-title">
            <h2>{note.title}</h2>
            {course.notes.length > 1 && <a href={note.url}>Note overview →</a>}
          </div>
          <ChapterList sections={note.sections} />
        </section>
      ))
    }

    {course.assetCount > 0 && <AssetList course={course} />}
  </div>
</BaseLayout>

<style>
  .hero {
    position: relative;
    border-bottom: 1px solid var(--border);
    background:
      radial-gradient(60% 120% at 0% 0%, color-mix(in srgb, var(--brand) 14%, transparent), transparent 65%),
      radial-gradient(50% 100% at 100% 0%, var(--glow-1), transparent 70%);
  }

  .hero-inner {
    max-width: 960px;
    padding-block: 1.75rem 2.25rem;
  }

  .back {
    display: inline-flex;
    align-items: center;
    gap: 0.35rem;
    font-size: 0.84rem;
    color: var(--text-muted);
  }

  .hero-main {
    display: flex;
    align-items: center;
    gap: 1.1rem;
    margin-top: 1.5rem;
  }

  .eyebrow {
    margin: 0 0 0.3rem;
  }

  h1 {
    margin: 0;
    font-size: clamp(1.9rem, 1.3rem + 2vw, 2.75rem);
    font-weight: 800;
    letter-spacing: -0.03em;
  }

  .desc {
    max-width: 62ch;
    margin: 1.1rem 0 0;
    font-size: 1.02rem;
    color: var(--text-muted);
  }

  .stats {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem 1.75rem;
    margin: 1.5rem 0 0;
    padding: 0;
    list-style: none;
    font-size: 0.875rem;
    color: var(--text-muted);
  }

  .stats strong {
    color: var(--text);
    font-weight: 650;
  }

  .progress-row {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    max-width: 460px;
    margin-top: 1.25rem;
    font-size: 0.8rem;
    color: var(--text-muted);
  }

  .progress-row .progress {
    flex: 1;
  }

  .cta {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
    margin-top: 1.5rem;
  }

  .body {
    max-width: 960px;
    padding-top: 2.5rem;
  }

  .note + .note {
    margin-top: 2.75rem;
  }
</style>
