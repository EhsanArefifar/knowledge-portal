---
import BaseLayout from '../layouts/BaseLayout.astro';
import CourseCard from '../components/CourseCard.astro';
import Icon from '../components/Icon.astro';
import LinkCard from '../components/LinkCard.astro';
import { quickAccessLinks, upcomingCourses } from '../data/links';
import { formatMinutes, getCourses, href } from '../lib/content';

const courses = await getCourses();
const chapters = courses.reduce((n, c) => n + c.sections.length, 0);
const minutes = courses.reduce((n, c) => n + c.totalMinutes, 0);
const assets = courses.reduce((n, c) => n + c.assetCount, 0);
const allIds = courses.flatMap((c) => c.sections.map((s) => s.id)).join('|');
---

<BaseLayout title="Home">
  <section class="hero">
    <div class="container hero-inner">
      <div class="hero-copy">
        <p class="eyebrow">Personal AI learning portal</p>
        <h1>Learn it once.<br /><span class="grad">Find it in seconds.</span></h1>
        <p class="lead">
          Notes from Claude and AI engineering courses, split into short chapters you can read, search and tick off —
          plus the agents, commands and skills built along the way.
        </p>
        <div class="cta">
          <a class="btn btn-primary" href={href('courses/')}>Browse courses <Icon name="arrowRight" size={16} /></a>
          <button type="button" class="btn" data-search-open><Icon name="search" size={16} /> Search notes <kbd>/</kbd></button>
        </div>
      </div>

      <div class="hero-side">
        <a class="continue card" data-continue-any hidden href="#">
          <span class="eyebrow">Continue reading</span>
          <span class="continue-title" data-continue-title></span>
          <span class="continue-course muted" data-continue-course></span>
          <span class="continue-go">Resume <Icon name="arrowRight" size={16} /></span>
        </a>
        <div class="stats card" data-progress={allIds}>
          <div><strong>{courses.length}</strong><span>courses</span></div>
          <div><strong>{chapters}</strong><span>chapters</span></div>
          <div><strong>{formatMinutes(minutes)}</strong><span>reading</span></div>
          <div><strong>{assets}</strong><span>assets</span></div>
          <div class="overall">
            <div class="progress"><span></span></div>
            <span data-progress-label>Not started</span>
          </div>
        </div>
      </div>
    </div>
  </section>

  <div class="container">
    <section class="block">
      <div class="section-title">
        <h2>Current courses</h2>
        <a href={href('courses/')}>All courses →</a>
      </div>
      <div class="grid">
        {courses.map((course) => <CourseCard course={course} />)}
      </div>
    </section>

    <div class="split">
      <section class="block">
        <div class="section-title">
          <h2>Up next</h2>
          <a href={href('next-courses/')}>See all →</a>
        </div>
        <div class="list">
          {upcomingCourses.map((c, i) => <LinkCard title={c.title} url={c.url} provider={c.provider} index={i + 1} />)}
        </div>
      </section>

      <section class="block">
        <div class="section-title">
          <h2>Quick access</h2>
          <a href={href('resources/')}>Resources →</a>
        </div>
        <div class="list">
          {quickAccessLinks.map((l) => <LinkCard title={l.label} url={l.url} description={l.description} provider={l.provider} />)}
        </div>
      </section>
    </div>
  </div>
</BaseLayout>

<style>
  .hero {
    position: relative;
    overflow: hidden;
    border-bottom: 1px solid var(--border);
    background:
      radial-gradient(45% 80% at 10% 0%, var(--glow-1), transparent 70%),
      radial-gradient(40% 70% at 90% 10%, var(--glow-2), transparent 70%);
  }

  .hero::before {
    content: '';
    position: absolute;
    inset: 0;
    background-image: radial-gradient(color-mix(in srgb, var(--text) 9%, transparent) 1px, transparent 1px);
    background-size: 22px 22px;
    mask-image: linear-gradient(to bottom, #000 0%, transparent 85%);
    pointer-events: none;
  }

  .hero-inner {
    position: relative;
    display: grid;
    grid-template-columns: minmax(0, 1.35fr) minmax(0, 1fr);
    gap: 3rem;
    align-items: center;
    padding-block: clamp(2.5rem, 7vw, 5rem);
  }

  h1 {
    margin: 0.75rem 0 1rem;
    font-size: clamp(2.2rem, 1.4rem + 3.4vw, 3.6rem);
    font-weight: 800;
    letter-spacing: -0.04em;
    line-height: 1.05;
  }

  .grad {
    background: linear-gradient(90deg, var(--accent), #d97757);
    -webkit-background-clip: text;
    background-clip: text;
    color: transparent;
  }

  .lead {
    max-width: 52ch;
    margin: 0;
    font-size: 1.08rem;
    color: var(--text-muted);
  }

  .cta {
    display: flex;
    flex-wrap: wrap;
    gap: 0.6rem;
    margin-top: 1.75rem;
  }

  .hero-side {
    display: flex;
    flex-direction: column;
    gap: 1rem;
  }

  .continue {
    display: flex;
    flex-direction: column;
    gap: 0.2rem;
    padding: 1.2rem 1.3rem;
    color: var(--text);
    border-color: color-mix(in srgb, var(--accent) 35%, var(--border));
    transition: box-shadow var(--t), transform var(--t);
  }

  .continue[hidden] {
    display: none;
  }

  .continue:hover {
    color: var(--text);
    box-shadow: var(--shadow);
    transform: translateY(-2px);
  }

  .continue .eyebrow {
    color: var(--accent);
  }

  .continue-title {
    font-size: 1.1rem;
    font-weight: 700;
    margin-top: 0.25rem;
  }

  .continue-course {
    font-size: 0.85rem;
  }

  .continue-go {
    display: inline-flex;
    align-items: center;
    gap: 0.35rem;
    margin-top: 0.6rem;
    font-size: 0.875rem;
    font-weight: 600;
    color: var(--accent);
  }

  .stats {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 1rem;
    padding: 1.2rem 1.3rem;
  }

  .stats > div:not(.overall) {
    display: flex;
    flex-direction: column;
  }

  .stats strong {
    font-size: 1.35rem;
    font-weight: 750;
    letter-spacing: -0.02em;
  }

  .stats span {
    font-size: 0.78rem;
    color: var(--text-muted);
  }

  .overall {
    grid-column: 1 / -1;
    display: flex;
    align-items: center;
    gap: 0.75rem;
  }

  .overall .progress {
    flex: 1;
  }

  .block {
    margin-top: 3.25rem;
  }

  .grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(min(100%, 380px), 1fr));
    gap: 1.25rem;
  }

  .split {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 0 2rem;
  }

  .list {
    display: flex;
    flex-direction: column;
    gap: 0.55rem;
  }

  @media (max-width: 900px) {
    .hero-inner,
    .split {
      grid-template-columns: 1fr;
    }
  }

  @media (max-width: 480px) {
    .stats {
      grid-template-columns: repeat(2, 1fr);
    }
  }
</style>
