---
import BaseLayout from '../layouts/BaseLayout.astro';
import LinkCard from '../components/LinkCard.astro';
import { upcomingCourses } from '../data/links';
import { getCourses } from '../lib/content';

const current = await getCourses();
---

<BaseLayout title="Up next">
  <div class="container page">
    <header class="head">
      <p class="eyebrow">Roadmap</p>
      <h1>Up next</h1>
      <p class="muted">Courses lined up after the current ones, in order. Each link opens the course page.</p>
    </header>

    <section>
      <h2 class="sub">Currently studying</h2>
      <div class="list">
        {
          current.map((c) =>
            c.sourceUrl ? (
              <LinkCard title={c.title} url={c.sourceUrl} description={c.description} provider={c.provider.name} />
            ) : null,
          )
        }
      </div>
    </section>

    <section>
      <h2 class="sub">Planned</h2>
      <div class="list">
        {upcomingCourses.map((c, i) => <LinkCard title={c.title} url={c.url} description={c.blurb} provider={c.provider} index={i + 1} />)}
      </div>
    </section>
  </div>
</BaseLayout>

<style>
  .page {
    max-width: 820px;
    padding-top: 2.5rem;
  }

  h1 {
    margin: 0.25rem 0 0.4rem;
    font-size: clamp(1.9rem, 1.4rem + 1.6vw, 2.5rem);
    font-weight: 800;
    letter-spacing: -0.03em;
  }

  .head p {
    margin: 0;
  }

  .sub {
    margin: 2.5rem 0 0.9rem;
    font-size: 1rem;
    font-weight: 650;
    color: var(--text-muted);
  }

  .list {
    display: flex;
    flex-direction: column;
    gap: 0.6rem;
  }
</style>
