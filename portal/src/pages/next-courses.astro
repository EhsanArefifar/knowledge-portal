---
/**
 * next-courses.astro — Next Courses page
 *
 * Requirements: 4.6, 11.1, 11.2
 *
 * - Renders exactly five Next Course titles as list items
 * - Title only — no invented enrollment links, durations, or difficulty (Req 11.2)
 */

import BaseLayout from '../layouts/BaseLayout.astro';
import { nextCourses } from '../data/nextCourses';
---

<BaseLayout
  title="Next Courses"
  description="Planned upcoming courses — what to study next."
>
  <div class="container page-content">
    <header class="page-header">
      <h1 class="page-title">Next Up</h1>
      <p class="page-subtitle text-muted">
        Planned courses on the learning roadmap.
      </p>
    </header>

    <!--
      Ordered list of exactly five course titles (Req 11.1).
      Title only — no invented metadata (Req 11.2).
    -->
    <ol class="next-courses-list" aria-label="Planned upcoming courses">
      {nextCourses.map((title) => (
        <li class="next-courses-item">
          <span class="next-courses-title">{title}</span>
        </li>
      ))}
    </ol>
  </div>
</BaseLayout>

<style>
  .page-content {
    padding-block: 2rem;
  }

  .page-header {
    margin-bottom: 1.75rem;
  }

  .page-title {
    font-size: 1.75rem;
    font-weight: 700;
    color: var(--color-text);
    margin: 0 0 0.25rem;
  }

  .page-subtitle {
    font-size: 0.9rem;
    margin: 0;
  }

  /* =====================================================================
     NEXT COURSES LIST
     Ordered list — title only, no invented metadata (Req 11.2)
     ===================================================================== */
  .next-courses-list {
    list-style: none;
    padding: 0;
    margin: 0;
    counter-reset: next-course-counter;
    display: flex;
    flex-direction: column;
    gap: 0.625rem;
    max-width: 36rem;
  }

  .next-courses-item {
    counter-increment: next-course-counter;
    display: flex;
    align-items: center;
    gap: 1rem;
    padding: 0.8rem 1rem;
    border: 1px solid var(--color-border);
    border-radius: var(--radius-card);
    background-color: var(--color-surface);
  }

  /* Counter bubble */
  .next-courses-item::before {
    content: counter(next-course-counter);
    display: flex;
    align-items: center;
    justify-content: center;
    flex-shrink: 0;
    width: 1.75rem;
    height: 1.75rem;
    background-color: var(--color-accent);
    color: #fff;
    font-size: 0.75rem;
    font-weight: 700;
    border-radius: 50%;
  }

  .next-courses-title {
    font-size: 0.9375rem;
    font-weight: 500;
    color: var(--color-text);
    line-height: 1.4;
  }
</style>
