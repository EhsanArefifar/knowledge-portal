---
import BaseLayout from '../layouts/BaseLayout.astro';
import LinkCard from '../components/LinkCard.astro';
import { quickAccessLinks, tools } from '../data/links';
---

<BaseLayout title="Resources">
  <div class="container page">
    <header class="head">
      <p class="eyebrow">Toolbox</p>
      <h1>Resources</h1>
      <p class="muted">Course platforms, documentation and tools worth keeping one click away.</p>
    </header>

    <section>
      <h2 class="sub">Quick access</h2>
      <div class="grid">
        {quickAccessLinks.map((l) => <LinkCard title={l.label} url={l.url} description={l.description} provider={l.provider} />)}
      </div>
    </section>

    <section>
      <h2 class="sub">Tools</h2>
      <div class="grid">
        {tools.map((l) => <LinkCard title={l.label} url={l.url} description={l.description} provider={l.provider} />)}
      </div>
    </section>
  </div>
</BaseLayout>

<style>
  .page {
    padding-top: 2.5rem;
  }

  h1 {
    margin: 0.25rem 0 0.4rem;
    font-size: clamp(1.9rem, 1.4rem + 1.6vw, 2.5rem);
    font-weight: 800;
    letter-spacing: -0.03em;
  }

  .head p {
    margin: 0;
  }

  .sub {
    margin: 2.5rem 0 0.9rem;
    font-size: 1rem;
    font-weight: 650;
    color: var(--text-muted);
  }

  .grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(min(100%, 340px), 1fr));
    gap: 0.75rem;
  }
</style>
